<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>elsugiyim-api-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.3" />
    <!-- Microsoft.AspNetCore.OpenApi varsayılan olarak güvenlik açığı (GHSA-v5pm-xwqc-g5wc)
         içeren Microsoft.OpenApi 2.0.0'ı çekiyor. Yamalı sürümü burada açıkça belirtip
         geçersiz kılıyoruz. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ElsuGiyim.Application\ElsuGiyim.Application.csproj" />
    <ProjectReference Include="..\ElsuGiyim.Infrastructure\ElsuGiyim.Infrastructure.csproj" />
  </ItemGroup>

</Project>
